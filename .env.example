# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. La publishable key es pública por diseño:
# viaja al navegador y lo que protege los datos es RLS, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Más adelante ───────────────────────────────────────────────────────────
# Se agregan cuando la fase que los necesita llegue, no antes:
#
#   F6 · captura y procesamiento
#     R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
#     TRIGGER_SECRET_KEY, TRIGGER_PROJECT_ID
#
#   F7 · análisis
#     OPENAI_API_KEY
#     HF_TOKEN   (modelos de pyannote para diarización)
